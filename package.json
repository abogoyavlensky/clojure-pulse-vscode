{
  "name": "clojure-pulse",
  "displayName": "Clojure Pulse",
  "description": "Lightweight, powerful Clojure and let-go support, powered by the clj-pulse language server.",
  "version": "0.0.1",
  "publisher": "abogoyavlensky",
  "license": "MIT",
  "author": "Andrey Bogoyavlenskiy",
  "repository": {
    "type": "git",
    "url": "https://github.com/abogoyavlensky/clojure-pulse-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:clojure",
    "workspaceContains:**/deps.edn",
    "workspaceContains:**/project.clj",
    "workspaceContains:**/lgx.edn"
  ],
  "contributes": {
    "languages": [
      {
        "id": "clojure",
        "aliases": ["Clojure", "clojure"],
        "extensions": [".clj", ".cljs", ".cljc", ".edn", ".bb", ".lg"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "clojure",
        "scopeName": "source.clojure",
        "path": "./syntaxes/clojure.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Clojure Pulse",
      "properties": {
        "clojurePulse.server.path": {
          "type": "string",
          "default": "clj-pulse",
          "markdownDescription": "Path to the `clj-pulse` language server binary. A bare name (e.g. `clj-pulse`) is resolved from your `PATH`; an absolute or relative path is used as-is."
        },
        "clojurePulse.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra command-line arguments passed to the clj-pulse server on startup."
        },
        "clojurePulse.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Traces the communication between VS Code and the clj-pulse language server."
        },
        "clojurePulse.dimIgnoredForms": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Dim `#_` discard forms and `(comment …)` blocks (brackets included). Reload the window to toggle."
        }
      }
    },
    "commands": [
      {
        "command": "clojurePulse.restart",
        "title": "Restart Server",
        "category": "Clojure Pulse"
      },
      {
        "command": "clojurePulse.showOutput",
        "title": "Show Output",
        "category": "Clojure Pulse"
      }
    ]
  },
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package-build": "tsc --noEmit && node esbuild.js --production",
    "vscode:prepublish": "npm run package-build",
    "compile-tests": "tsc -p . --outDir out",
    "lint": "eslint src",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}
