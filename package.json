{
  "name": "clojure-pulse",
  "displayName": "Clojure Pulse",
  "description": "Lightweight, powerful Clojure and let-go support, powered by the clj-pulse language server.",
  "version": "0.0.1",
  "publisher": "abogoyavlensky",
  "license": "MIT",
  "author": "Andrey Bogoyavlenskiy",
  "repository": {
    "type": "git",
    "url": "https://github.com/abogoyavlensky/clojure-pulse-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:clojure",
    "workspaceContains:**/deps.edn",
    "workspaceContains:**/project.clj",
    "workspaceContains:**/lgx.edn"
  ],
  "contributes": {},
  "scripts": {
    "compile": "tsc --noEmit && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package-build": "tsc --noEmit && node esbuild.js --production",
    "vscode:prepublish": "npm run package-build",
    "compile-tests": "tsc -p . --outDir out",
    "lint": "eslint src",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "eslint": "^9.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.0.0"
  }
}
